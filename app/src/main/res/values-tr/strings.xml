    <string name="dialog_weather_setup_title">Önemli Adım</string>
    <string name="dialog_weather_setup_message">Hava durumu kısa süre içinde widget\'ınızda görünmezse:\n\nBreezy Weather → Ayarlar → Harici Modüller → \'Send Gadgetbridge Data\' seçeneğini etkinleştirin ve \'Lwidget\'ı açın.</string>
