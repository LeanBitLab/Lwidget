<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_dark"
    android:padding="16dp">

    <!-- Time (Top Left) -->
    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed-light"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="-4dp"
        android:includeFontPadding="false"/>

    <!-- Battery (Top Right) -->
    <TextView
        android:id="@+id/text_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed-light"
        android:text="--%"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>

    <!-- Temp (Below Battery) -->
    <TextView
        android:id="@+id/text_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed-light"
        android:text="--°C"
        android:textColor="#CCFFFFFF"
        android:textSize="18sp"
        android:layout_below="@id/text_battery"

    
        android:layout_alignParentEnd="true"/>

    <!-- Data Usage (Below Temp) -->
    <TextView
        android:id="@+id/text_data_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- MB"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_below="@id/text_temp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"/>

    <!-- Date (Below Time) -->
    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed-light"
        android:format12Hour="EEEE, MMMM dd"
        android:format24Hour="EEEE, MMMM dd"
        android:textSize="18sp"
        android:textColor="#CCFFFFFF"
        android:layout_below="@id/clock_time"
        android:layout_alignParentStart="true"/>

    <!-- Calendar Events (for expanded sizes - dynamically filled) -->
    <LinearLayout
        android:id="@+id/events_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed-light"
        android:orientation="vertical"
        android:layout_below="@id/clock_date"
        android:layout_marginTop="8dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <TextView android:id="@+id/text_event_1" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_2" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_3" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_4" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_5" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_6" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_7" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_8" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_9" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_10" style="@style/EventText" android:fontFamily="sans-serif-condensed-light" android:visibility="gone"/>

    </LinearLayout>

</RelativeLayout>
