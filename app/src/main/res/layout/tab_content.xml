<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_tab_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

<!-- CATEGORY: CONTENT -->
<TextView
    android:id="@+id/label_category_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/category_content"
    android:textColor="?attr/colorPrimary"
    android:textStyle="bold"
    android:textSize="14sp"
    android:letterSpacing="0.05"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"/>


<!-- FEATURE: Time -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_time"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/settings_folded_header"
            android:id="@+id/header_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/content_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_time_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <include layout="@layout/settings_slider_row"
                android:id="@+id/row_time_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <include layout="@layout/settings_selector_row"
                android:id="@+id/row_time_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <include layout="@layout/settings_selector_row"
                android:id="@+id/row_time_clock_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

