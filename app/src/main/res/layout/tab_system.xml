<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_tab_system"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

<!-- CATEGORY: SYSTEM -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/category_system"
    android:textColor="?attr/colorPrimary"
    android:textStyle="bold"
    android:textSize="14sp"
    android:letterSpacing="0.05"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"/>

<!-- FEATURE: Language -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_language"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/settings_folded_header"
            android:id="@+id/header_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/content_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <include layout="@layout/settings_selector_row"
                android:id="@+id/row_app_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- FEATURE: Advanced -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_advanced"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/settings_folded_header"
            android:id="@+id/header_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/content_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <include layout="@layout/settings_slider_row"
                android:id="@+id/row_update_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/note_update_interval"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_keep_alive_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_battery_optimization_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/note_battery_optimization"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- FEATURE: Permissions -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_permissions"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/settings_folded_header"
            android:id="@+id/header_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/content_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_data_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_screen_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                
            <include layout="@layout/settings_toggle_row"
                android:id="@+id/row_perm_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- FEATURE: About -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_about"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/settings_folded_header"
            android:id="@+id/header_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/content_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lwidget"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_changelog_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Version 1.0"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/changelog_author"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <!-- Expandable Changelog Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_changelog"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Changelog Header Row (Clickable) -->
                    <LinearLayout
                        android:id="@+id/header_changelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/changelog_title"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/chevron_changelog"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <!-- Changelog Expanded Content -->
                    <LinearLayout
                        android:id="@+id/content_changelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/changelog_content"
                            android:lineSpacingMultiplier="1.3"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_website_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/official_website"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:autoLink="web"
                android:linksClickable="true"/>

            <TextView
                android:id="@+id/tv_github_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/github_source_code"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:autoLink="web"
                android:linksClickable="true"/>

            <TextView
                android:id="@+id/tv_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/privacy_policy"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
