<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    
    >
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_fill"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_outline"
        android:visibility="visible"
        android:importantForAccessibility="no" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <!-- Time (Top Left) -->
    
    <LinearLayout
        android:id="@+id/time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical">
        <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:includeFontPadding="false"/>
        
        <TextView
            android:id="@+id/text_world_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="18sp"
            android:layout_marginStart="16dp"
            android:includeFontPadding="false"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Battery (Top Right) -->
    <TextView
        android:id="@+id/text_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="--%"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>

    <!-- Temp (Below Battery) -->
    <TextView
        android:id="@+id/text_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="--°C"
        android:textColor="#CCFFFFFF"
        android:textSize="18sp"
        android:layout_below="@id/text_battery"

    
        android:layout_alignParentEnd="true"/>

    <!-- Data Usage (Below Temp) -->
    <TextView
        android:id="@+id/text_data_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- MB"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_below="@id/text_temp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"/>
    <TextView
        android:id="@+id/text_storage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_below="@id/text_data_usage"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"/>

    <!-- Date (Below Time) -->
    
    <LinearLayout
        android:id="@+id/date_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/time_container"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical">
        <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:format12Hour="EEEE, MMMM dd"
        android:format24Hour="EEEE, MMMM dd"
        android:textSize="18sp"
        android:textColor="#CCFFFFFF"
        />
        
        <TextView
            android:id="@+id/text_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Calendar Events (for expanded sizes - dynamically filled) -->
    <LinearLayout
        android:id="@+id/events_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:orientation="vertical"
        android:layout_below="@id/date_container"
        android:layout_marginTop="8dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <TextView android:id="@+id/text_event_1" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_2" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_3" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_4" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_5" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_6" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_7" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_8" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_9" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_10" style="@style/EventText" android:fontFamily="sans-serif-condensed" android:visibility="gone"/>

    </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
