<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- SCROLLABLE TOP BAR (Auto-hides on scroll down, enters on scroll up) -->
        <FrameLayout
            android:id="@+id/top_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="?attr/colorSurface"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- NORMAL MODE: Title, Widget Selector, and Search Toggle Icon -->
            <LinearLayout
                android:id="@+id/header_normal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/title_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lwidget"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/subtitle_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Default Settings ▾"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_search_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_settings_hint"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- SEARCH MODE: Back, Query Field, Clear -->
            <LinearLayout
                android:id="@+id/header_search_mode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_search_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/a11y_close_search"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorOnSurface" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_settings_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_settings_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_search_clear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/a11y_clear_search"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </FrameLayout>

        <!-- PERSISTENT WIDGET PREVIEW CONTAINER (Pinned above tabs) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:background="?attr/colorSurface">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_preview"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                android:clipChildren="true"
                android:clipToPadding="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Wallpaper / Backdrop View -->
                    <ImageView
                        android:id="@+id/preview_wallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_preview_wallpaper"
                        android:importantForAccessibility="no" />

                    <!-- Live RemoteViews Preview Container -->
                    <FrameLayout
                        android:id="@+id/preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- MATERIAL 3 PILL TABS (Pinned at top) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:background="?attr/colorSurface">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_tab_container"
                app:tabIndicator="@drawable/bg_tab_indicator"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorGravity="stretch"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabSelectedTextColor="?attr/colorOnPrimary"
                app:tabTextColor="?attr/colorOnSurfaceVariant"
                app:tabIconTint="@color/selector_tab_icon"
                app:tabTextAppearance="@style/Widget.Lwidget.TabTextAppearance"
                app:tabRippleColor="@null"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabInlineLabel="false" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/nested_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="80dp">



            <!-- TAB 1: STYLE -->
            <ViewStub
                android:id="@+id/stub_tab_style"
                android:inflatedId="@+id/container_tab_style"
                android:layout="@layout/tab_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- TAB 2: CONTENT -->
            <ViewStub
                android:id="@+id/stub_tab_content"
                android:inflatedId="@+id/container_tab_content"
                android:layout="@layout/tab_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- TAB 3: LAYOUT / REORDER -->
            <ViewStub
                android:id="@+id/stub_tab_layout"
                android:inflatedId="@+id/container_tab_layout"
                android:layout="@layout/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- TAB 4: SYSTEM -->
            <ViewStub
                android:id="@+id/stub_tab_system"
                android:inflatedId="@+id/container_tab_system"
                android:layout="@layout/tab_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save/Apply FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="@string/btn_update_widget"
        app:icon="@android:drawable/ic_popup_sync"
        app:iconTint="?attr/colorOnPrimaryContainer"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:textColor="?attr/colorOnPrimaryContainer"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="3dp"
        app:rippleColor="?attr/colorControlHighlight"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
